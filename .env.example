APP_NAME=Client Intelligence OS
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
TRUSTED_PROXY_IPS=[]
MAX_API_REQUEST_BODY_BYTES=131072
APPLICATION_ABUSE_CONTROLS_ENABLED=false
RATE_LIMITER_MAX_KEYS=4096
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=600
AUTH_CALLBACK_RATE_LIMIT=10
AUTH_CALLBACK_RATE_WINDOW_SECONDS=600
WORKSPACE_READ_RATE_LIMIT=120
WORKSPACE_READ_RATE_WINDOW_SECONDS=60
WORKSPACE_MUTATION_RATE_LIMIT=30
WORKSPACE_MUTATION_RATE_WINDOW_SECONDS=60
ANALYSIS_SHORT_RATE_LIMIT=6
ANALYSIS_SHORT_RATE_WINDOW_SECONDS=600
ANALYSIS_DAILY_RATE_LIMIT=30
ANALYSIS_DAILY_RATE_WINDOW_SECONDS=86400
INFERENCE_WORKSPACE_CONCURRENCY=1
INFERENCE_GLOBAL_CONCURRENCY=2
INFERENCE_CAPACITY_RETRY_AFTER_SECONDS=5
PORT=8000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/callback
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
OIDC_STATE_SECRET=
CSRF_SECRET=

AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=4096
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
ALLOW_DETERMINISTIC_FALLBACK=true
PROMPT_VERSION=client-intelligence-v1
